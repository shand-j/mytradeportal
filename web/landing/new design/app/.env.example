# Public TestFlight join link (shown in every beta CTA). Swap for the App Store
# URL at launch.
VITE_TESTFLIGHT_URL=https://testflight.apple.com/join/XXXXXXXX

# Paddle — sandbox for now; swap to production token + production price IDs at
# launch. Only VITE_ vars are exposed to the browser.
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Price IDs (pri_...) — monthly + yearly per tier, from the matching catalog.
VITE_PADDLE_PRICE_STARTER_MONTH=
VITE_PADDLE_PRICE_STARTER_YEAR=
VITE_PADDLE_PRICE_PRO_MONTH=
VITE_PADDLE_PRICE_PRO_YEAR=
VITE_PADDLE_PRICE_BUSINESS_MONTH=
VITE_PADDLE_PRICE_BUSINESS_YEAR=
