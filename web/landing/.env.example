# Public TestFlight join link (shown in every beta CTA). Swap for the App Store
# URL at launch.
NEXT_PUBLIC_TESTFLIGHT_URL=https://testflight.apple.com/join/XXXXXXXX

# Paddle — sandbox for now; swap to production token + production price IDs at
# launch. Only NEXT_PUBLIC_ vars are exposed to the browser.
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Price IDs (pri_...) — monthly + yearly per tier, from the matching catalog.
NEXT_PUBLIC_PADDLE_PRICE_STARTER_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_STARTER_YEAR=
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEAR=
NEXT_PUBLIC_PADDLE_PRICE_BUSINESS_MONTH=
NEXT_PUBLIC_PADDLE_PRICE_BUSINESS_YEAR=
