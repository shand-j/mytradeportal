# Copy to .env and adjust for local development.
# Never commit real secrets.

ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://mtp:mtp@localhost:5432/mtp

# Application database role (used in production; default matches local docker compose).
APP_ROLE_NAME=mtp_app
APP_ROLE_PASSWORD=mtp_app

REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

MINIO_ENDPOINT=localhost:9000
# Set to true when MinIO is reached over HTTPS (e.g. a public Railway domain);
# presigned upload URLs must match the scheme the browser uses.
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mtp-uploads

POSTGRES_USER=mtp
POSTGRES_PASSWORD=mtp
POSTGRES_DB=mtp

# Back-office UI. Leave empty to derive the API URL from the current hostname.
VITE_API_BASE_URL=

# Mobile app (Expo / React Native). EXPO_PUBLIC_* vars are inlined at build time.
# For the iOS Simulator, localhost points at the host Mac. For a physical device,
# use the host machine's LAN IP (e.g. http://192.168.1.42:8000).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
# Target business for white-label branding; empty = generic/marketplace build.
EXPO_PUBLIC_BUSINESS_SLUG=demo
EXPO_PUBLIC_SETUP_TOKEN=

# Auth (change in production)
AUTH_SECRET_KEY=dev-auth-secret-key-change-in-production
# Keep true in real production (HTTPS); set false only for local HTTP prod-like tests.
AUTH_COOKIE_SECURE=true

# --- AI provider (LLM via LiteLLM, OpenAI-compatible) ---------------------
# Chat LLM. Defaults to OpenAI. To use Kimi / Moonshot (OpenAI-compatible),
# set the three LLM_* vars below and leave LLM_TEMPERATURE blank (kimi-k*
# models reject a custom temperature).
#
#   Kimi example:
#     LLM_API_BASE=https://api.moonshot.ai/v1
#     LLM_API_KEY=sk-...            # your Moonshot key
#     LLM_MODEL=openai/kimi-k2.6    # openai/ prefix = OpenAI-compatible route
#     LLM_TEMPERATURE=
#
#   OpenAI example:
#     OPENAI_API_KEY=sk-...
#     LLM_MODEL=gpt-4o-mini
LLM_MODEL=gpt-4o-mini
LLM_API_BASE=
LLM_API_KEY=
LLM_TEMPERATURE=0.2
# Kimi quote JSON typically takes 60–120s. LiteLLM's own default is 60s, so
# leaving this unset causes half the golden-set to time out. Keep at 180 unless
# your provider is faster.
LLM_TIMEOUT_SECONDS=180
# Public landing-page demo (/demo/quotes/*): routes generation to OpenAI
# (DEMO_LLM_MODEL, default gpt-4o-mini) whenever OPENAI_API_KEY is set, so the
# demo stays fast even when the production pipeline uses a slow model (Kimi).
# Without an OPENAI_API_KEY the demo falls back to the LLM_* config above.
DEMO_LLM_MODEL=gpt-4o-mini

# Embeddings power optional catalogue grounding. Kimi has no embeddings API,
# so this stays on OpenAI (or any OpenAI-compatible embeddings endpoint). If no
# embedding key is set, catalogue retrieval is skipped and quotes are generated
# from the model's own guide prices.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=

# Setup/bootstrap token required to create the first tenant + admin in production.
SETUP_TOKEN=

# Railway feature flags (Signals) — project token + project id used by the api
# service to read runtime flags. Leave empty in local dev; all flags stay off.
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=

# Supabase Auth (optional — local CLI values from `pnpm exec supabase status`)
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Domestic electrical data pipeline (Apify)
APIFY_API_TOKEN=
PIPELINE_DEMO_MODE=false
SCREWFIX_START_URL=https://www.screwfix.com/c/electrical-lighting/cat840780
SCREWFIX_MAX_ITEMS=10000
SCREWFIX_SCRAPE_DETAILS=false
SCREWFIX_MAX_TOTAL_CHARGE_USD=50
SCREWFIX_TIMEOUT_SECONDS=600
TOOLSTATION_ENABLED=false
SCRAPE_FREQUENCY=monthly
MONTHLY_RUN_DAY=1

# Email delivery (Resend preferred; SMTP/Mailpit fallback for local dev)
RESEND_API_KEY=
# Branded sender for quote/invoice mail: tenant name + Reply-To to the tenant.
RESEND_FROM_EMAIL=quotes@yourdomain.com
# Transactional sender for password resets / account mail (platform-branded,
# no Reply-To). Falls back to RESEND_FROM_EMAIL when unset.
RESEND_NO_REPLY_EMAIL=no-reply@yourdomain.com
APP_PUBLIC_URL=https://app.mytradeportal.com
