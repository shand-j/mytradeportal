# Copy to .env and adjust for local development.
# Never commit real secrets.

ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://mtp:mtp@localhost:5432/mtp
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

MINIO_ENDPOINT=localhost:9000
# Set to true when MinIO is reached over HTTPS (e.g. a public Railway domain);
# presigned upload URLs must match the scheme the browser uses.
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=mtp-uploads

POSTGRES_USER=mtp
POSTGRES_PASSWORD=mtp
POSTGRES_DB=mtp

# Back-office UI. Leave empty to derive the API URL from the current hostname.
VITE_API_BASE_URL=

# Auth (change in production)
AUTH_SECRET_KEY=dev-auth-secret-key-change-in-production
# Keep true in real production (HTTPS); set false only for local HTTP prod-like tests.
AUTH_COOKIE_SECURE=true

# OpenAI (required AI provider for LLM generation and embeddings, via LiteLLM)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Setup/bootstrap token required to create the first tenant + admin in production.
SETUP_TOKEN=

# Railway feature flags (Signals) — project token + project id used by the api
# service to read runtime flags. Leave empty in local dev; all flags stay off.
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=

# Supabase Auth (optional — local CLI values from `pnpm exec supabase status`)
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Domestic electrical data pipeline (Apify)
APIFY_API_TOKEN=
PIPELINE_DEMO_MODE=false
SCREWFIX_START_URL=https://www.screwfix.com/c/electrical-lighting/cat840780
SCREWFIX_MAX_ITEMS=10000
SCREWFIX_SCRAPE_DETAILS=false
SCREWFIX_MAX_TOTAL_CHARGE_USD=50
SCREWFIX_TIMEOUT_SECONDS=600
TOOLSTATION_ENABLED=false
SCRAPE_FREQUENCY=monthly
MONTHLY_RUN_DAY=1
