# Expo's recommended pnpm layout: babel/metro resolve presets and plugins by
# walking up from the project dir, which requires a hoisted node_modules.
# Without this, EAS's Xcode "Bundle React Native code and images" phase fails
# with cascading "Cannot find module 'babel-preset-expo'" /
# "'transformFile' undefined" errors under pnpm's default isolated linker.
node-linker=hoisted
