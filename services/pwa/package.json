    "expo": "~57.0.13",
    "expo-image": "~57.0.3",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-css-interop": "^0.2.6",
