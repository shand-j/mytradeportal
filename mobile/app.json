{
  "expo": {
    "name": "My Trade Portal",
    "slug": "mtp-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "mtp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mytradeportal.mobile",
      "buildNumber": "1",
      "newArchEnabled": false
    },
    "android": {
      "package": "com.mytradeportal.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow My Trade Portal to attach photos from your library to jobs and quote requests."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow My Trade Portal to use your location so tradespeople can see job areas and plan visits."
        }
      ],
      "expo-notifications"
    ]
  }
}
