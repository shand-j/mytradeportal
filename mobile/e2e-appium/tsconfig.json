{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "mocha", "@wdio/globals/types"]
  },
  "include": ["./specs/**/*.ts", "./helpers/**/*.ts", "./wdio.conf.ts"]
}
